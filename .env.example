NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

BREVO_API_KEY=
BREVO_CONTACT_TO=contact@vistaire.ca
BREVO_CONTACT_SENDER_EMAIL=contact@vistaire.ca
BREVO_CONTACT_SENDER_NAME=Vistaire

TRANSLATION_PROVIDER=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_REGION=
TRANSLATION_MAX_CHARS_PER_RUN=50000

# Server-only secret used to pepper QR token hashes and sign the dev fallback
# token. Set this in production. See docs/owner-qr-schema.md.
VISTAIRE_QR_TOKEN_SECRET=
VISTAIRE_QR_TOKEN_PREVIOUS_SECRETS=
# Server-only AES-256-GCM key ring for recoverable canonical owner QR tokens.
VISTAIRE_QR_TOKEN_ACTIVE_KEY_VERSION=
VISTAIRE_QR_TOKEN_KEY_RING=
VISTAIRE_ADMIN_SESSION_SECRET=
VISTAIRE_EXPECTED_SUPABASE_PROJECT_REF=
VISTAIRE_QR_DIAGNOSTICS=0

# Read-only QR environment rollout preflight. Configure Preview and Production
# separately; never commit values. See docs/qa/qr-environment-rollout-runbook.md.
VISTAIRE_QR_PREFLIGHT_ENVIRONMENT=
VISTAIRE_QR_PREFLIGHT_OTHER_SUPABASE_PROJECT_REF=
VISTAIRE_QR_PREFLIGHT_PUBLIC_BASE_URL=
VISTAIRE_QR_PREFLIGHT_OTHER_PUBLIC_BASE_URL=
VISTAIRE_QR_PREFLIGHT_EXPECTED_SCHEMA_CONTRACT=
VISTAIRE_QR_PREFLIGHT_OTHER_SERVICE_ROLE_FINGERPRINT=
VISTAIRE_QR_PREFLIGHT_OTHER_PEPPER_FINGERPRINTS=
VISTAIRE_QR_PREFLIGHT_OTHER_KEY_FINGERPRINTS=
VISTAIRE_QR_PREFLIGHT_OTHER_ADMIN_SESSION_FINGERPRINT=

NEXT_PUBLIC_DEMO_RESTAURANT_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_DEMO_MENU_ID=22222222-2222-2222-2222-222222222222

# Optional verified public Vistaire profiles used for sameAs JSON-LD and footer links.
NEXT_PUBLIC_VISTAIRE_LINKEDIN_URL=
NEXT_PUBLIC_VISTAIRE_INSTAGRAM_URL=
NEXT_PUBLIC_VISTAIRE_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_VISTAIRE_FACEBOOK_URL=
